APP_NAME="Ephesus Mediterranean Delights"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ephesus.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database — Primary (write)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ephesus
DB_USERNAME=ephesus
DB_PASSWORD=

# Database — Read Replica
DB_READ_HOST=postgres-replica
DB_READ_USERNAME=ephesus_reader
DB_READ_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Horizon
HORIZON_PREFIX=ephesus_horizon:

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=.ephesus.com

# Mail
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@ephesus.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=ephesus-media
AWS_URL=
AWS_SES_REGION=eu-west-1

# Filesystem
FILESYSTEM_DISK=s3

# Meilisearch
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

# Vonage (SMS)
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM="Ephesus"

# WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Sentry
SENTRY_LARAVEL_DSN=

# JWT
JWT_SECRET=
JWT_TTL=1440

# 2FA
TWO_FACTOR_ENABLED=true
