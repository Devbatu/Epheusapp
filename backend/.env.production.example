APP_NAME="Ephesus Mediterranean Delights"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://celaning.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── MySQL (Hostinger) — hPanel → Veritabanları → MySQL ────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u453302981_ephesus
DB_USERNAME=u453302981_ephesus
DB_PASSWORD=CHANGE_ME

# ─── No Redis on shared hosting — use database/file drivers ────────────
CACHE_DRIVER=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ─── Mail (Hostinger SMTP) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@celaning.com
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@celaning.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Filesystem ────────────────────────────────────────────────────────
FILESYSTEM_DISK=public

# ─── Search: no Meilisearch → collection driver ────────────────────────
SCOUT_DRIVER=collection

# ─── SPA same-origin; no cross-origin CORS needed ──────────────────────
SANCTUM_STATEFUL_DOMAINS=celaning.com,www.celaning.com
CORS_ALLOWED_ORIGINS=https://celaning.com,https://www.celaning.com

TELESCOPE_ENABLED=false
